# Printer Hisob frontend — PRODUCTION build .env namunasi
# Serverda:  cp .env.production.example .env   (keyin: npm run build)
#
# MUHIM: VITE_API_BASE ni BO'SH qoldiring. Shunda dashboard API'ga nisbiy
# "/api/..." manzil orqali murojaat qiladi va nginx uni backend'ga proxy qiladi
# (bir xil origin — CORS kerak emas, token/parol bundle'ga tushmaydi).
VITE_API_BASE=

# VITE_API_KEY endi ishlatilmaydi (auth JWT token orqali). Bo'sh qoldiring.
VITE_API_KEY=
