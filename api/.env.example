# PostgreSQL ulanish satri (asyncpg drayveri bilan)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/printer_hisob

# Ixtiyoriy. Agar to'ldirilsa, POST so'rovlar X-API-Key sarlavhasini talab qiladi.
# Bo'sh qoldirilsa autentifikatsiya o'chiriladi.
API_KEY=

# Ishga tushganda jadvallarni avtomatik yaratish (prod'da alembic ishlating)
AUTO_CREATE_TABLES=true

# Dashboard foydalanuvchisi (login sahifasi uchun login/parol). Bo'sh bo'lsa
# /api/auth/login "fail-closed" ishlaydi — token berilmaydi.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# JWT tokenlarni imzolash uchun maxfiy kalit. Bo'sh bo'lsa /api/auth/login ishlamaydi.
JWT_SECRET=

# JWT token amal qilish muddati (daqiqalarda). Standart 720 (12 soat)
JWT_EXPIRE_MINUTES=720

# Agent shu daqiqadan beri signal bermasa, "aloqasi yo'q" deb belgilanadi
# (heartbeat oralig'idan kattaroq qiling). Standart 60.
AGENT_STALE_MINUTES=60

# Agent jarayoni shu soniyadan kam vaqt oldin ishga tushgan bo'lsa "yaqinda
# qayta ishga tushgan" (recentlyRestarted) deb belgilanadi — doimiy qulab
# tushib qayta ishga tushayotgan (crash-loop) agentni aniqlash uchun. Standart 600.
AGENT_RECENT_RESTART_SECONDS=600

# Standart (default) qog'oz kvotasi — xodim uchun tegishli davrga aniq kvota
# (EmployeeQuota) belgilanmagan bo'lsa shu qiymat ishlatiladi (0 emas). Ikkalasi
# mustaqil qiymatlar (chorak = oy x 3 emas). Standart: oy 200, chorak 300.
DEFAULT_QUOTA_MONTH=200
DEFAULT_QUOTA_QUARTER=300

# AD sinxronizatsiya skripti soatiga bir marta ishga tushadi. `employees.synced_at`
# shu daqiqadan ko'p vaqt yangilanmasa, sinxronizatsiya to'xtagan ("eskirgan"/stale)
# deb belgilanadi. Standart 180 (3 soat = ikkita o'tkazib yuborilgan sinxronizatsiya).
AD_SYNC_STALE_MINUTES=180
