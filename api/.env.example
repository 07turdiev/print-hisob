# PostgreSQL ulanish satri (asyncpg drayveri bilan)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/printer_hisob

# Ixtiyoriy. Agar to'ldirilsa, POST so'rovlar X-API-Key sarlavhasini talab qiladi.
# Bo'sh qoldirilsa autentifikatsiya o'chiriladi.
API_KEY=

# Ishga tushganda jadvallarni avtomatik yaratish (prod'da alembic ishlating)
AUTO_CREATE_TABLES=true

# Dashboard foydalanuvchisi (login sahifasi uchun login/parol). Bo'sh bo'lsa
# /api/auth/login "fail-closed" ishlaydi — token berilmaydi.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# JWT tokenlarni imzolash uchun maxfiy kalit. Bo'sh bo'lsa /api/auth/login ishlamaydi.
JWT_SECRET=

# JWT token amal qilish muddati (daqiqalarda). Standart 720 (12 soat)
JWT_EXPIRE_MINUTES=720

# Agent shu daqiqadan beri signal bermasa, "aloqasi yo'q" deb belgilanadi
# (heartbeat oralig'idan kattaroq qiling). Standart 60.
AGENT_STALE_MINUTES=60
