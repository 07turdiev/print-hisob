# Printer Hisob backend — PRODUCTION .env namunasi
# Serverda nusxa oling va real qiymatlar bilan to'ldiring:
#   cp .env.production.example .env
# Maxfiy kalitlarni generatsiya qilish:  openssl rand -hex 32

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://print_hisob:CHANGE_ME_DB_PAROL@localhost:5432/print_hisob_db

# --- Ingest agentlari (.exe) uchun API kalit ---
# BO'SH QOLDIRMANG. .exe har print paketida shu kalitni X-API-Key sarlavhasida yuboradi.
API_KEY=CHANGE_ME_API_KALIT

# --- Dashboard foydalanuvchisi (JWT login) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME_KUCHLI_PAROL
JWT_SECRET=CHANGE_ME_UZUN_TASODIFIY_KALIT
JWT_EXPIRE_MINUTES=720

# --- Jadvallarni avtomatik yaratish ---
# Yangi (bo'sh) bazada true qoldiring — barcha jadvallar joriy modellardan yaratiladi
# (duplex, document_pages, position bilan; directorate yo'q).
AUTO_CREATE_TABLES=true

# --- CORS ---
# Frontend nginx orqali BIR XIL origin'da xizmat qilsa, bo'sh qoldiring (CORS kerak emas).
# Agar dashboard boshqa domenda bo'lsa: CORS_ORIGINS=https://boshqa-domen.uz
CORS_ORIGINS=

# --- Agent (heartbeat) monitoring ---
# Agent shu daqiqadan beri signal bermasa, "aloqasi yo'q" deb belgilanadi
# (heartbeat oralig'idan kattaroq qiling). Standart 60.
AGENT_STALE_MINUTES=60

# Agent jarayoni shu soniyadan kam vaqt oldin ishga tushgan bo'lsa "yaqinda
# qayta ishga tushgan" (recentlyRestarted) deb belgilanadi — doimiy qulab
# tushib qayta ishga tushayotgan (crash-loop) agentni aniqlash uchun. Standart 600.
AGENT_RECENT_RESTART_SECONDS=600

# --- Standart (default) qog'oz kvotasi ---
# Xodim uchun tegishli davrga aniq kvota (EmployeeQuota) belgilanmagan bo'lsa
# shu qiymat ishlatiladi (0 emas) — aks holda hamma "limitdan oshgan" ko'rinadi.
# Ikkalasi mustaqil qiymatlar (chorak = oy x 3 emas). Standart: oy 200, chorak 300.
DEFAULT_QUOTA_MONTH=200
DEFAULT_QUOTA_QUARTER=1000

# --- Agent bilan kvota almashinuvi (POST /api/print-quotas) ---
# Agent bir vaqtda faqat BITTA davr bo'yicha hisoblay oladi, dashboardda esa
# ikkitasi (oylik va choraklik) bor — qaysi biri agentga yuborilishini shu
# sozlama belgilaydi. Qiymatlar: "quarter" yoki "month".
AGENT_QUOTA_PERIOD_TYPE=quarter

# Javobda har bir foydalanuvchining haqiqiy (butun flot bo'yicha) sarfini
# yuboramizmi. true — agent o'z hisoblagichini bizning raqamimiz bilan
# almashtiradi (aniq, lekin allaqachon limitdan oshganlar darhol bloklanadi).
# false — agent o'z hisobini davom ettiradi (yumshoqroq boshlanish).
AGENT_QUOTA_REPORT_USED=true

# --- AD sinxronizatsiyasi monitoring ---
# AD sinxronizatsiya skripti soatiga bir marta ishga tushadi. `employees.synced_at`
# shu daqiqadan ko'p vaqt yangilanmasa, sinxronizatsiya to'xtagan ("eskirgan"/stale)
# deb belgilanadi. Standart 180 (3 soat = ikkita o'tkazib yuborilgan sinxronizatsiya).
AD_SYNC_STALE_MINUTES=180
